{
  "name": "odo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm db:start && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "db:start": "docker compose -f infra/compose.yml --env-file .env.development up -d --remove-orphans && node --env-file=.env.development infra/scripts/wait-for-postgres.js",
    "migrate:up": "pnpm db:start && node-pg-migrate -m migrations up",
    "migrate:down": "pnpm db:start && node-pg-migrate -m migrations down",
    "migrate:create": "node-pg-migrate -m migrations create",
    "test:integration": "pnpm db:start && concurrently -k -s second \"next dev\" \"jest\""
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@swc/core": "^1.15.33",
    "@swc/jest": "^0.2.39",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "jest": "^30.4.2",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
